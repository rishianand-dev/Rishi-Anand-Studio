datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id              String   @id @default(cuid())
  title           String
  slug            String   @unique
  description     String
  longDescription String?
  category        String   @default("Full Stack")
  tags            String[]
  featured        Boolean  @default(false)
  imageUrl        String
  demoUrl         String?
  githubUrl       String?
  stars           Int      @default(0)
  metrics         String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Experience {
  id          String   @id @default(cuid())
  role        String
  company     String
  period      String
  location    String
  description String
  skills      String[]
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Education {
  id          String   @id @default(cuid())
  degree      String
  institution String
  period      String
  location    String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Skill {
  id        String   @id @default(cuid())
  category  String   @default("Frontend") // Frontend, Backend, Practices, Tools
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id            String   @id @default(cuid())
  name          String
  email         String
  subject       String?
  message       String
  attachmentUrl String?
  read          Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model Profile {
  id               String   @id @default("default-profile")
  name             String   @default("Alex Miller")
  role             String   @default("SOFTWARE ENGINEER · BASED IN NEW YORK")
  location         String   @default("New York, NY")
  headline         String   @default("I build digital products that feel effortless.")
  subheadline      String   @default("Product-minded engineer crafting fast, thoughtful experiences at the intersection of design and technology.")
  availableForWork Boolean  @default(true)
  avatarUrl        String?
  resumeUrl        String?  @default("/resume.pdf")
  githubUrl        String?  @default("https://github.com")
  linkedinUrl      String?  @default("https://linkedin.com")
  twitterUrl       String?  @default("https://twitter.com")
  contactEmail     String   @default("rishianand.w@gmail.com")
  footerBrand      String   @default("AM.")
  footerLabel      String   @default("Liquid Glass Engineer Portfolio")
  footerCopyright  String   @default("All rights reserved.")
  footerTechStack  String   @default("Designed with Next.js, PostgreSQL, Neon Storage, Zustand & TypeScript")
  aboutLabel      String   @default("ABOUT & PHILOSOPHY")
  aboutHeading    String   @default("Where engineering precision meets design craft.")
  aboutIntroTitle String   @default("Hi, I’m {name} — crafting software that scales effortlessly.")
  aboutParagraphOne String @default("Over the past 6+ years, I've dedicated myself to building high-scale full-stack applications and silky user interfaces. I bridge the gap between creative visual design and bulletproof distributed systems.")
  aboutParagraphTwo String @default("Whether I'm fine-tuning WebGL shaders, architecting multi-tenant PostgreSQL databases, or structuring predictable global client state with Zustand, my goal remains constant: software that feels weightless and effortless.")
  aboutResumeLabel String @default("Access Resume (PDF)")
  aboutGithubLabel String @default("GitHub Profile")
  aboutContactLabel String @default("Contact me")
  aboutPrincipleOneTitle String @default("Performance-First")
  aboutPrincipleOneDescription String @default("Zero layout shift, 60fps animations, optimized bundle footprints, and aggressive edge caching.")
  aboutPrincipleTwoTitle String @default("Micro-Interactions & Polish")
  aboutPrincipleTwoDescription String @default("Obsessed with fluid transitions, haptics, spring physics, and thoughtful states that make software feel alive.")
  aboutPrincipleThreeTitle String @default("Scalable Architecture")
  aboutPrincipleThreeDescription String @default("Robust PostgreSQL schemas, type-safe full-stack contracts, clean Zustand stores, and resilient cloud storage.")
  heroTechStack   String   @default("NEXT.JS 14,POSTGRESQL,NEON STORAGE,ZUSTAND")
  heroCodeLineOne String   @default("const craft =")
  heroCodeLineTwo String   @default("detail +")
  heroCodeLineThree String @default("curiosity;")
  heroStatusLabel String   @default("CURRENTLY")
  heroStatusText  String   @default("Building for the web")
  techStackCategoryOrder String @default("Frontend,Backend,Practices")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SeoSettings {
  id              String   @id @default("default-seo")
  metaTitle       String   @default("Alex Miller — Liquid Glass Engineer Portfolio")
  metaDescription String   @default("Product-minded software engineer crafting fast, thoughtful digital experiences at the intersection of design and technology.")
  keywords        String   @default("Software Engineer, Full Stack, Next.js, TypeScript, PostgreSQL, WebGL, Liquid Glass")
  ogImageUrl      String?  @default("https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?q=80&w=1200&auto=format&fit=crop")
  canonicalUrl    String?  @default("https://alexmiller.dev")
  twitterHandle   String?  @default("@alexmiller")
  robots          String   @default("index, follow")
  updatedAt       DateTime @updatedAt
}
